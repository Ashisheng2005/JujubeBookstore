# 需要代理的源（拷贝漫画等）填这里，本机实测 Clash 混合端口为 7897
# 留空则只用直连
JUJUBE_PROXY=http://127.0.0.1:7897

# 服务监听
JUJUBE_HOST=127.0.0.1
JUJUBE_PORT=8000

# 上游超时（秒）、幂等 GET 重试次数、缓存 TTL（秒）
JUJUBE_TIMEOUT=20
JUJUBE_HTTP_RETRIES=2
JUJUBE_DETAIL_TTL=600
JUJUBE_CHAPTER_TTL=300

# 图片中转（防盗链/CORS），关闭填 0
JUJUBE_IMAGE_PROXY=1
JUJUBE_IMAGE_PROXY_MAX_BYTES=15728640

# Download manager (single application process)
JUJUBE_DOWNLOAD_DIR=./downloads
# Unset to use downloads.db inside JUJUBE_DOWNLOAD_DIR
JUJUBE_DOWNLOAD_DB=./downloads/downloads.db
JUJUBE_DOWNLOAD_WORKERS=2
JUJUBE_DOWNLOAD_IMAGE_CONCURRENCY=4
JUJUBE_DOWNLOAD_RETRIES=3
JUJUBE_DOWNLOAD_RESUME=1
JUJUBE_DOWNLOAD_BATCH_MAX_ITEMS=100
